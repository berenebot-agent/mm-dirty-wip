{
  "id": "mammothmail",
  "name": "Mammoth Mail",
  "description": "Email inbox connector for OpenClaw through a Mammoth Mail relay.",
  "channels": ["mammothmail"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "mammothmail": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["baseUrl", "gatewayId", "secret"],
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "name": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string",
            "description": "Mammoth Mail base URL"
          },
          "gatewayId": {
            "type": "string",
            "description": "Connector gateway id"
          },
          "secret": {
            "type": "string",
            "description": "Relay authentication secret"
          },
          "allowFrom": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional OpenClaw-side sender allowlist. Mammoth Mail inbox allowlists are the primary gate."
          },
          "dmPolicy": {
            "type": "string",
            "enum": ["allowlist", "open", "pairing"],
            "default": "allowlist"
          },
          "agentId": {
            "type": "string",
            "description": "Optional agent id to route this inbox to"
          }
        }
      },
      "uiHints": {
        "baseUrl": {
          "label": "Mammoth Mail URL"
        },
        "gatewayId": {
          "label": "Gateway ID"
        },
        "secret": {
          "label": "Relay secret",
          "sensitive": true
        }
      }
    }
  }
}
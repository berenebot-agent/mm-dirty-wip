# Optional — startup generates /data/encryption_key (mode 0600) when unset and
# no file exists, so a fresh deployment needs no key. Supply your own to keep it
# out of a /data backup (min 24 chars). Changing it later leaves stored provider
# credentials unreadable and they must be re-entered.
#APP_ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-24-characters
# Set to the exact address used to access MailMoose (default: http://localhost:8081).
# Enable before production use; generated links, passkeys and integrations need it.
# Use https:// only when accessing MailMoose through HTTPS.
#BASE_URL=https://mail.example.com

# Core — uncomment to override shown defaults
#DATA_DIR=/data
#MODE=selfhosted
#LISTEN_ADDR=:8081
# Optional HTTP webhook-only listener; webhook routes remain on the main port.
#DEDICATED_RECEIVER_ENABLE=true
#DEDICATED_RECEIVER_PORT=8082
# Optional public receiver origin. Omitted/blank uses BASE_URL even when enabled.
#DEDICATED_RECEIVER_URL=https://receive.example.com
# Inbound provider secrets are no longer configured here: add a receive path per
# domain in the Admin UI (or PUT /v1/admin/domains/{id}/receiving). They are
# stored encrypted.
#ALLOW_REGISTRATION=false

# System administrator credentials. When set, they are authoritative: MailMoose
# creates the system administrator on first start and, on every later start,
# rotates its stored login to match (revoking its sessions if either changed).
# When both are absent the stored system administrator is left untouched, so a
# deployment may omit them once provisioned. Set the email and password
# together; either may come from a *_FILE secret. Setting both a value and its
# _FILE form is a startup error. Never logged.
#ADMIN_EMAIL=admin@example.com
#ADMIN_PASSWORD=correct-horse-battery-staple
#ADMIN_EMAIL_FILE=/run/secrets/mailmoose_admin_email
#ADMIN_PASSWORD_FILE=/run/secrets/mailmoose_admin_password
# Optional display name for the system administrator's own account.
#ADMIN_ACCOUNT_NAME=MailMoose

# Runtime user. A container boots as root only to chown a fresh ./data bind
# mount, then drops to this uid:gid before opening the database. Selects the
# runtime user for the app (and the app process in embedded MX mode).
# Leave unset to use 65532:65532, or set both to run ./data as your own user.
# A strict compose `user:` skips the boot chown and must own ./data itself.
#MAILMOOSE_RUN_UID=65532
#MAILMOOSE_RUN_GID=65532

# Trusted proxies — comma-separated IPs or CIDRs whose X-Forwarded-* headers are
# trusted (client IP, scheme). Leave empty to trust none. A catch-all (/0) range
# is refused at startup, because it would let any caller choose its own
# rate-limit identity; the removed TRUST_PROXY_HEADERS=true trust-all mode is
# refused for the same reason. TRUSTED_PROXIES strips trusted hops from the
# right of the chain.
#TRUSTED_PROXIES=10.0.0.0/8,192.168.1.0/24
# Redirect plaintext requests to https://<BASE_URL host> and report https in
# discovery documents. Set this when TLS terminates at a reverse proxy and the
# app must never answer over cleartext. BASE_URL must therefore be https://...
# when FORCE_HTTPS=true. Webhook (/internal/*) and health endpoints are never
# redirected, and a relay WebSocket upgrade from a TRUSTED_PROXIES caller is
# passed through too (a WebSocket client cannot follow a redirect). Requires
# TRUSTED_PROXIES so the proxy's X-Forwarded-Proto is believed; otherwise
# redirects cannot be sure the request was already encrypted and may loop.
#FORCE_HTTPS=false

# Outbound SSRF guard. When true (the default) outbound transports (HTTP provider
# API base, SMTP, Direct MX, and the per-account Remote MX receiver) may reach
# private/loopback/LAN destinations — normal for self-hosting through a private
# gateway, local relay, or a receiver on your own network. Set this to false to
# confine every outbound connection to public-routable destinations; that policy
# is global and a tenant cannot re-enable private destinations per account.
#ALLOW_PRIVATE_OUTBOUND=true

# Tuning — defaults from internal/config
#MAX_MESSAGE_BYTES=31457280
#DEFAULT_STORAGE_QUOTA_BYTES=104857600
#SESSION_TTL_HOURS=336
# Require an Authorization: Bearer <anything> header on relay enrolment.
# Presence-only: the value is NOT validated, so this deters naive scanners but
# is not authentication. The one-time enrolment token remains the authority.
#RELAY_REQUIRE_CALLER_AUTH=false
#LOGIN_LIMIT_PER_MINUTE=10
#SEND_LIMIT_PER_MINUTE=60
# Signup attempts per source IP per minute (only relevant when ALLOW_REGISTRATION=true).
#REGISTER_LIMIT_PER_MINUTE=5
# External email approval validity window in hours (0 disables expiry).
#APPROVAL_EXPIRY_HOURS=48

# Inbound hardening
#INBOUND_CONCURRENCY=32
#MAX_MULTIPART_PARTS=64
#MAX_MIME_DEPTH=8
#MAX_MIME_PARTS=256
#BODY_READ_TIMEOUT_SECONDS=30

# --- Direct-SMTP (MX) ingress ------------------------------------------------
# Direct MX is configured in each domain's Receiving settings and uses the
# receiver bundled with this deployment. Remote MX is a separate, account-level
# option for a receiver you run yourself. These persisted settings are the only
# source of the core's receiver configuration: the core no longer imports
# legacy MX_ENABLE / MX_RECEIVER_URL / DIALMX_CORE_KEY / MX_* values.
#
# The only MX settings that belong in an environment file are the
# STANDALONE RECEIVER's own: give them to the receiver container
# (mailmoose-mx), never to the core, and never give the receiver the core's
# .env, /data or APP_ENCRYPTION_KEY. For Remote MX, enter the matching
# DIALMX_CORE_KEY in that account's Remote MX settings.
#
# Receiver container only (see docs/REMOTE_MX.md and the Remote MX receiver section in README.md):
#DIALMX_MODE=single
#DIALMX_CORE_KEY=replace-with-openssl-rand-hex-32-output
#DIALMX_LISTEN_ADDR=:8443
#MX_HOSTNAME=mail.example.com
#MX_LISTEN_ADDR=:2525
#MX_VERIFY_SPF=true
#MX_VERIFY_DKIM=true
#MX_VERIFY_DMARC=true
#MX_DNS_RESOLVER=
#MX_DNS_TIMEOUT_SECONDS=10
# Ordered resolver failover used by the core and the edge: the host's configured
# nameservers are tried first, then these public resolvers, only when an exchange
# fails (valid answers, including NXDOMAIN, are authoritative and never retried
# elsewhere). Empty selects 1.1.1.1,1.0.0.1,8.8.8.8,8.8.4.4; "off" disables it.
#MAILMOOSE_DNS_FALLBACK_SERVERS=
#MX_MAX_MESSAGE_BYTES=31457280
# In-memory staging cap across concurrent transactions; a burst above it fails
# temporarily rather than risking an OOM kill.
#MX_STAGING_BYTES=268435456
#MX_MAX_RECIPIENTS=100
#MX_MAX_CONNECTIONS=256
#MX_READ_TIMEOUT_SECONDS=60
#MX_WRITE_TIMEOUT_SECONDS=60
#MX_DATA_TIMEOUT_SECONDS=300
# Offer STARTTLS when set together (opportunistic senders encrypt by default).
# Set MX_REQUIRE_TLS=true with these to refuse plaintext SMTP entirely.
#MX_TLS_CERT=
#MX_TLS_KEY=
#MX_REQUIRE_TLS=false
# Optional session TLS in single mode; required in shared mode.
#DIALMX_TLS_CERT=
#DIALMX_TLS_KEY=
# Single mode accepts cleartext sessions from any peer by default (self-hosting);
# the receiver logs a startup warning because the bearer key and mail then cross
# the wire unencrypted. Set true to accept cleartext only from loopback or
# DIALMX_TRUSTED_PROXIES.
#DIALMX_REQUIRE_TLS=false
# Optional health/readiness listener for the receiver (/healthz, /readyz).
#MX_HEALTH_ADDR=:8090

# Advanced core tuning (optional; defaults from internal/config).
# Embedded (Included) receiver uid/gid, separate from the app runtime user.
#MX_UID=65533
#MX_GID=65533
#MX_RECEIPT_RETENTION_HOURS=168
# Optional PEM bundle for private receiver CAs (system roots retained).
#DIALMX_CA_FILE=/certs/receiver-ca.pem
#INBOUND_TLS_CERT_FILE=
#INBOUND_TLS_KEY_FILE=
